
{
  "name": "iPhone Optimized Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "luth.touch-terminal",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
  "window.zoomLevel": 0,
  "window.commandCenter": true,

  "workbench.activityBar.location": "top",
  "workbench.sideBar.location": "left",
  "workbench.editor.showTabs": "single",
  "workbench.editor.enablePreview": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 4,
  "workbench.editor.limit.perEditorGroup": false,
  "workbench.statusBar.visible": false,
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.list.smoothScrolling": false,

  "breadcrumbs.enabled": false,
  "explorer.compactFolders": true,
  "explorer.autoReveal": false,

  "editor.fontSize": 11,
  "editor.lineHeight": 11,
  "editor.fontLigatures": false,
  "editor.wordWrap": "on",
  "editor.wrappingIndent": "none",
  "editor.lineNumbers": "off",
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.smoothScrolling": false,
  "editor.cursorBlinking": "solid",
  "editor.renderLineHighlight": "none",
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,
  "editor.guides.indentation": false,
  "editor.guides.bracketPairs": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.matchBrackets": "never",
  "editor.colorDecorators": false,

  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
  "editor.codeLens": false,
  "editor.inlayHints.enabled": "off",
  "editor.hover.enabled": "off",
  "editor.lightbulb.enabled": "off",
  "editor.parameterHints.enabled": false,

  "editor.quickSuggestions": false,
  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.inlineSuggest.enabled": false,
  "editor.semanticHighlighting.enabled": false,

  "editor.formatOnType": false,
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,

  "editor.largeFileOptimizations": true,
  "editor.maxTokenizationLineLength": 5000,
  "editor.scrollBeyondLastLine": false,
  "editor.scrollbar.verticalScrollbarSize": 16,

  "diffEditor.renderSideBySide": false,

  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.1,
  "terminal.integrated.scrollback": 500,
  "terminal.integrated.persistentSessionScrollback": 100,
  "terminal.integrated.tabs.enabled": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.smoothScrolling": false,
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.gpuAcceleration": "auto",

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 2000,

  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true
  },

  "npm.autoDetect": "off",
  "js/ts.tsc.autoDetect": "off",
  "javascript.suggest.autoImports": false,
  "typescript.suggest.autoImports": false,

  "git.autofetch": false,
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none",

  "extensions.ignoreRecommendations": true
      }
  },
  "forwardPorts": [
    3000,
    5173,
    8000,
    8080,
    9001
  ],
  "portsAttributes": {
    "3000": {
      "label": "Next.js"
    },
    "5173": {
      "label": "Vite"
    },
    "8000": {
      "label": "Backend API"
    },
    "8080": {
      "label": "Web Service"
    },
    "9001": {
      "label": "Worker"
    }
  }
}
