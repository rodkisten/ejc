{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ejc-mini-mercado",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ejc-mini-mercado",
      "database_id": "e2df25e0-4f7c-4dcf-9c38-349c9aa53293",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ejc-mini-mercado-media",
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://ejc.migos.club",
  },
}
